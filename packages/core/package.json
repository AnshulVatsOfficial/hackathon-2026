{
  "name": "agentdrop-portability-core",
  "version": "1.0.10",
  "description": "Headless core engine for AgentDrop",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'),path=require('path');function r(d){if(!fs.existsSync(d))return;for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);if(e.isDirectory())r(p);else if(p.endsWith('.map'))fs.unlinkSync(p);}}r('./dist/src');\"",
    "test": "node --test dist/tests/*.test.js",
    "test:security": "node --test dist/tests/security.test.js",
    "test:validator": "node --test dist/tests/validator.test.js",
    "test:git": "node --test dist/tests/git.test.js",
    "test:fallback": "node --test dist/tests/fallback.test.js",
    "test:capsule": "node --test dist/tests/capsule.test.js",
    "test:adapters": "node --test dist/tests/adapters.test.js",
    "test:p2p": "node --test dist/tests/p2p.test.js",
    "test:e2e": "node --test dist/tests/e2e.test.js",
    "ai:save": "agentdrop save",
    "ai:resume": "agentdrop load",
    "ai:status": "agentdrop status",
    "ai:ui": "agentdrop ui",
    "postinstall": "agentdrop hook install"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
