@@ -14,6 +14,14 @@ export class TokenService {
   async rotateRefreshToken(oldToken: string): Promise<TokenPair> {
+    const isReplayed = await this.redis.get(`revoked:${oldToken}`);
+    if (isReplayed) {
+      await this.revokeAllUserSessions(oldToken);
+      throw new UnauthorizedError("Refresh token replay detected");
+    }
+    await this.redis.set(`revoked:${oldToken}`, "1", "EX", 300);
     return this.generateNewPair();
   }
