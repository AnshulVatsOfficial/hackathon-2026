{
  "name": "agentdrop-portability-cli",
  "version": "1.0.15",
  "description": "Standalone CLI companion for AgentDrop",
  "main": "dist/src/index.js",
  "type": "module",
  "bin": {
    "agentdrop": "bin/agentdrop.js",
    "agentdrop-portability-cli": "bin/agentdrop.js"
  },
  "files": [
    "dist/src",
    "bin",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'),path=require('path');function r(d){if(!fs.existsSync(d))return;for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);if(e.isDirectory())r(p);else if(p.endsWith('.map'))fs.unlinkSync(p);}}r('./dist/src');\"",
    "prepublishOnly": "npm run build",
    "test": "node --test dist/tests/*.test.js",
    "ai:resume": "agentdrop load",
    "ai:status": "agentdrop status",
    "ai:save": "agentdrop save",
    "postinstall": "agentdrop hook install"
  },
  "dependencies": {
    "agentdrop-portability-core": "1.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "agentdrop-portability-cli": "^1.0.15"
  }
}
