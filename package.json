{
  "name": "agentdrop-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AgentDrop - Local-first AI context portability layer for coding agents",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=agentdrop-portability-core && npm run build --workspace=agentdrop-portability-cli",
    "test": "npm run test --workspace=agentdrop-portability-core && npm run test --workspace=agentdrop-portability-cli",
    "agentdrop": "node packages/cli/bin/agentdrop.js",
    "test:security": "npm run test:security --workspace=agentdrop-portability-core",
    "test:validator": "npm run test:validator --workspace=agentdrop-portability-core",
    "test:git": "npm run test:git --workspace=agentdrop-portability-core",
    "test:fallback": "npm run test:fallback --workspace=agentdrop-portability-core",
    "test:capsule": "npm run test:capsule --workspace=agentdrop-portability-core",
    "test:e2e": "npm run test:e2e --workspace=agentdrop-portability-core",
    "ai:save": "agentdrop save",
    "ai:resume": "agentdrop load",
    "ai:status": "agentdrop status",
    "postinstall": "agentdrop hook install"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
